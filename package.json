{
  "name": "project-launcher",
  "productName": "Project Launcher",
  "version": "2.0.0",
  "description": "Open everything you need for a project in one click. Websites · Terminals · Folders · Files. / Öffne alles, was du für ein Projekt brauchst, mit einem Klick. Webseiten · Terminals · Ordner · Dateien.",
  "main": "src/main.js",
  "desktopName": "project-launcher.desktop",
  "license": "MIT",
  "author": "Melanie Klenner",
  "repository": "github:klennerlab/project-launcher",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.klennerlab.projectlauncher",
    "productName": "Project Launcher",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${name}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "artifactName": "${name}-linux-x64.${ext}",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-windows.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${name}-portable-windows.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
